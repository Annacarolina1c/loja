<?php
$conn = new mysqli("localhost", "root", "", "loja");

if ($conn->connect_error) {
    die("Erro: " . $conn->connect_error);
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // PEGAR DADOS
    $nome_cliente = $_POST["nome_cliente"] ?? '';
    $cpf = $_POST["cpf"] ?? '';
    $endereco_cliente = $_POST["endereco_cliente"] ?? '';

    $rua = $_POST["rua"] ?? '';
    $numero = $_POST["numero"] ?? '';
    $bairro = $_POST["bairro"] ?? '';
    $cidade = $_POST["cidade"] ?? '';
    $estado = $_POST["estado"] ?? '';
    $cep = $_POST["cep"] ?? '';

    $quantidade_calca = $_POST["quantidade_calca"] ?? '';
    $preco_fornecedor = $_POST["preco_fornecedor"] ?? '';
    $preco_venda = $_POST["preco_venda"] ?? '';
    $cnpj_estoque = $_POST["cnpj_estoque"] ?? '';

    $nome_fornecedor = $_POST["nome_fornecedor"] ?? '';
    $cnpj_fornecedor = $_POST["cnpj_fornecedor"] ?? '';
    $quantidade_produto = $_POST["quantidade_produto"] ?? '';
    $preco = $_POST["preco"] ?? '';
    $endereco_fornecedor = $_POST["endereco_fornecedor"] ?? '';

    $cpf_cliente = $_POST["cpf_cliente"] ?? '';
    $vendedor_responsavel = $_POST["vendedor_responsavel"] ?? '';
    $quantidade_estoque = $_POST["quantidade_estoque"] ?? '';
    $valor_total = $_POST["valor_total"] ?? '';
    $data_venda = $_POST["data_venda"] ?? '';

    $nome_vendedor = $_POST["nome_vendedor"] ?? '';
    $quantidade_vendas = $_POST["quantidade_vendas"] ?? '';
    $cliente_vendas = $_POST["cliente_vendas"] ?? '';

    // VALIDAÇÃO (NÃO DEIXA SALVAR VAZIO)
    if (
        !empty($nome_cliente) &&
        !empty($cpf) &&
        !empty($endereco_cliente) &&
        !empty($nome_fornecedor) &&
        !empty($cnpj_fornecedor) &&
        !empty($nome_vendedor)
    ) {

        // INSERT CLIENTE
        $conn->query("INSERT INTO cliente (nome, cpf, endereco_cliente)
        VALUES ('$nome_cliente','$cpf','$endereco_cliente')");

        // INSERT ENDEREÇO
        $conn->query("INSERT INTO endereco (rua, numero, bairro, cidade, estado, cep)
        VALUES ('$rua','$numero','$bairro','$cidade','$estado','$cep')");

        // INSERT ESTOQUE
        $conn->query("INSERT INTO estoque (quantidade_calca, preco_fornecedor, preco_venda, cnpj_endereco)
        VALUES ('$quantidade_calca','$preco_fornecedor','$preco_venda','$cnpj_estoque')");

        // INSERT FORNECEDOR
        $conn->query("INSERT INTO fornecedor (nome_fornecedor, cnpj_fornecedor, quantidade_produto, preco, endereco_fornecedor)
        VALUES ('$nome_fornecedor','$cnpj_fornecedor','$quantidade_produto','$preco','$endereco_fornecedor')");

        // INSERT VENDA
        $conn->query("INSERT INTO venda (cpf_cliente, vendedor_responsavel, quantidade_estoque, valor_total, data_venda)
        VALUES ('$cpf_cliente','$vendedor_responsavel','$quantidade_estoque','$valor_total','$data_venda')");

        // INSERT VENDEDOR
        $conn->query("INSERT INTO vendedor (nome_vendedor, quantidade_vendas, cliente_vendas)
        VALUES ('$nome_vendedor','$quantidade_vendas','$cliente_vendas')");

        echo "<h3>✅ TODOS OS DADOS FORAM SALVOS!</h3>";

    } else {
        echo "<h3>⚠️ Preencha os campos obrigatórios!</h3>";
    }
}
?>

