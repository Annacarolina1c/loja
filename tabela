<?php
$conn = new mysqli("localhost", "root", "", "loja");

if ($conn->connect_error) {
    die("Erro: " . $conn->connect_error);
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // CLIENTE
    $nome = $_POST['nome'] ?? '';
    $cpf = $_POST['cpf'] ?? '';

    // ENDEREÇO
    $endereco = $_POST['endereco'] ?? '';
    $rua = $_POST['rua'] ?? '';
    $bairro = $_POST['bairro'] ?? '';
    $cep = $_POST['cep'] ?? '';
    $numero = $_POST['numero'] ?? '';
    $complemento = $_POST['complemento'] ?? '';

    // FORNECEDOR
    $nomeF = $_POST['nome_fornecedor'] ?? '';
    $cnpjF = $_POST['cnpj_fornecedor'] ?? '';
    $produto = $_POST['produto_calca'] ?? '';
    $precoForn = $_POST['preco_fornecedor'] ?? '';

    // ESTOQUE
    $qnt = $_POST['qntdo_calca'] ?? '';
    $precoVenda = $_POST['preco_venda'] ?? '';

    // VENDEDOR (NOVO)
    $nomeV = $_POST['nome_vendedor'] ?? '';
    $qntVendas = $_POST['qntdo_vendas'] ?? '';
    $clientesV = $_POST['cliente_vendas'] ?? '';

    // VENDA
    $quantidadeVenda = $_POST['quantidade'] ?? '';

    if (empty($nome) || empty($cpf)) {
        echo "Preencha cliente!";
    } else {

        // 🔹 CLIENTE
        $stmt1 = $conn->prepare("INSERT INTO cliente (nome, cpf) VALUES (?, ?)");
        $stmt1->bind_param("ss", $nome, $cpf);
        $stmt1->execute();

        // 🔹 ENDEREÇO
        $stmt2 = $conn->prepare("INSERT INTO endereco 
        (Endereco, Rua, Bairro, Cep, Numero, Complemento)
        VALUES (?, ?, ?, ?, ?, ?)");

        $stmt2->bind_param("sssiss", $endereco, $rua, $bairro, $cep, $numero, $complemento);
        $stmt2->execute();

        // 🔹 FORNECEDOR
        $stmt3 = $conn->prepare("INSERT INTO fornecedor 
        (nome, cnpj, produto_calca, preco)
        VALUES (?, ?, ?, ?)");

        $stmt3->bind_param("siii", $nomeF, $cnpjF, $produto, $precoForn);
        $stmt3->execute();

        // 🔹 ESTOQUE
        $stmt4 = $conn->prepare("INSERT INTO estoque 
        (qntdo_calca, preco_fornecedor, preco_venda, cnpj)
        VALUES (?, ?, ?, ?)");

        $stmt4->bind_param("iiii", $qnt, $precoForn, $precoVenda, $cnpjF);
        $stmt4->execute();

        $estoque_id = $conn->insert_id;

        // 🔹 VENDEDOR (AGORA CADASTRA)
        $stmt6 = $conn->prepare("INSERT INTO vendedor 
        (nome, qntdo_vendas, cliente_vendas)
        VALUES (?, ?, ?)");

        $stmt6->bind_param("sii", $nomeV, $qntVendas, $clientesV);
        $stmt6->execute();

        $vendedor_id = $conn->insert_id;

        // 🔹 VENDA (AGORA LIGADA AO VENDEDOR)
        $valor_total = $quantidadeVenda * $precoVenda;
        $data = date("Ymd");

        $stmt5 = $conn->prepare("INSERT INTO venda 
        (cpf_cliente, vendedor_id, estoque_id, quantidade, valor_total, data_venda)
        VALUES (?, ?, ?, ?, ?, ?)");

        $stmt5->bind_param("iiiiii", $cpf, $vendedor_id, $estoque_id, $quantidadeVenda, $valor_total, $data);

        if ($stmt5->execute()) {
            echo "SISTEMA COMPLETO COM VENDEDOR FUNCIONANDO!";
        } else {
            echo "Erro: " . $stmt5->error;
        }

        $stmt1->close();
        $stmt2->close();
        $stmt3->close();
        $stmt4->close();
        $stmt5->close();
        $stmt6->close();
    }
}

$conn->close();
?>

