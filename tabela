<!DOCTYPE html>
<html>
<head>
    <title>Cadastro de Venda</title>
</head>
<body>

<h2>Cadastro de Venda</h2>

<form method="POST" action="">

    <label>CPF do Cliente:</label><br>
    <input type="number" name="cpf_cliente" required><br><br>

    <label>Nome do Vendedor:</label><br>
    <input type="text" name="nome_vendedor" required><br><br>

    <label>Quantidade em Estoque:</label><br>
    <input type="number" name="quantidade_estoque" required><br><br>

    <label>Valor Total:</label><br>
    <input type="number" name="valor_total" required><br><br>

    <label>Data da Venda:</label><br>
    <input type="number" name="data_venda" placeholder="Ex: 20260407" required><br><br>

    <button type="submit">Cadastrar</button>

</form>

</body>
</html>
